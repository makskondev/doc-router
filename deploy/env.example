# Все настройки — плоские переменные окружения (ConfigMap / Secret в k8s). Пути UNC пишутся как есть, без экранирования.
Courier__PollInterval=00:10:00

Dirs__BrokRep=\\fd\brok_rep
Dirs__BrokRepEmail=\\fd\brok_rep\email
Dirs__SignedDocs=\\fd\signed_docs
Dirs__DepoReports=\\fd\depo_reports
Dirs__WasSignedDepo=\\fd\sign_proc\was_signed\depo
Dirs__WasSignedBrok=\\fd\sign_proc\was_signed\brok
Dirs__BrokDocs=\\fd\brok\docs
Dirs__BrokToSign=\\fd\sign_proc\to_sign\brok
Dirs__CorpSignedDoc=\\fd\corp\signed_doc

# Группы адресатов ошибок (несколько адресов через ; или ,). Mail__Default получает ВСЕ письма
Mail__Default=docs-support@corp.ru
Mail__Brokers=broker-team@corp.ru;ops@corp.ru
Mail__Depo=depo-team@corp.ru

# Собственный архив подписей/метаданных, состояние долгих потоков и журнал операций (схема создаётся при старте)
Postgres__ConnectionString=Host=pg;Database=docrouter;Username=docrouter;Password=<secret>

Smb__Domain=CORP
Smb__User=svc-docrouter
Smb__Password=<secret>

SignatureService__SignUrl=https://sign.corp.ru/api/sign
SignatureService__VerifyUrl=https://sign.corp.ru/api/verify

Oracle__ConnectionString=User Id=docrouter;Password=<secret>;Data Source=//oracle:1521/SERVICE
Oracle__MarkSignedProcedure=PKG_DOCS.MARK_REPORT_SIGNED
Oracle__CreateRecordProcedure=PKG_DOCS.CREATE_SIGNED_FILE

Smtp__Host=smtp.corp.ru
Smtp__Port=25
Smtp__From=docrouter@corp.ru
