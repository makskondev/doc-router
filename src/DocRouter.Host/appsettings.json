{
  "Courier": {
    "PollInterval": "00:10:00",
    "MaxParallel": 4,
    "ReadinessMultiplier": 3,
    "DefaultRecipients": [
      "docs-support@example.com"
    ]
  },
  "Sources": {
    "Views": [
      {
        "Name": "VIEW_1",
        "Route": "Agreements",
        "IdColumn": "DOC_ID",
        "FileNameColumn": "FILE_NAME",
        "DocTypeColumn": "DOC_TYPE"
      },
      {
        "Name": "VIEW_2",
        "Route": "Invoices",
        "IdColumn": "DOC_ID",
        "FileNameColumn": "FILE_NAME",
        "DocTypeColumn": "DOC_TYPE"
      }
    ],
    "Directories": [
      {
        "Route": "Letters",
        "RequireSignature": false,
        "MinAge": "00:01:00",
        "Extensions": [
          ".pdf"
        ]
      },
      {
        "Route": "SignedLetters",
        "RequireSignature": true,
        "SignatureSuffix": ".sig",
        "MinAge": "00:01:00"
      }
    ]
  },
  "Routes": {
    "Agreements": {
      "Incoming": "\\\\fileserver\\docs\\agreements\\in",
      "ToSign": "\\\\fileserver\\docs\\agreements\\tosign",
      "Signed": "\\\\fileserver\\docs\\agreements\\signed",
      "Result": "\\\\fileserver\\archive\\agreements",
      "ErrorRecipients": [
        "agreements-team@example.com"
      ]
    },
    "Invoices": {
      "Incoming": "\\\\fileserver\\docs\\invoices\\in",
      "Result": "\\\\fileserver\\archive\\invoices",
      "ErrorRecipients": [
        "invoices-team@example.com"
      ]
    },
    "Letters": {
      "Incoming": "\\\\fileserver\\docs\\letters\\in",
      "Result": "\\\\fileserver\\archive\\letters",
      "TypeRules": [
        {
          "Prefix": "ORD_",
          "Type": "Order"
        },
        {
          "Mask": "NTF_*.pdf",
          "Type": "Notice"
        }
      ],
      "DefaultType": "Letter",
      "ErrorRecipients": [
        "letters-team@example.com"
      ]
    },
    "SignedLetters": {
      "Incoming": "\\\\fileserver\\docs\\signedletters\\in",
      "Result": "\\\\fileserver\\archive\\signedletters",
      "ErrorRecipients": [
        "letters-team@example.com"
      ]
    }
  },
  "Types": {
    "Contract": {
      "Stamp": "contract",
      "ErrorRecipients": [
        "contracts@example.com"
      ]
    },
    "Addendum": {
      "Stamp": "addendum",
      "ErrorRecipients": [
        "contracts@example.com"
      ]
    },
    "Order": {
      "ErrorRecipients": [
        "orders@example.com"
      ]
    }
  },
  "Stamps": {
    "contract": {
      "TemplatePath": "/app/stamps/contract.png",
      "TimeZone": "Europe/Moscow",
      "Lines": [
        {
          "Text": "Согласовано {Date}",
          "X": 20,
          "Y": 50,
          "FontSize": 24
        },
        {
          "Text": "{AUTHOR}",
          "X": 20,
          "Y": 90,
          "FontSize": 20
        }
      ],
      "Page": -1,
      "X": 30,
      "Y": 30,
      "WidthPt": 160,
      "HeightPt": 60
    },
    "addendum": {
      "TemplatePath": "/app/stamps/addendum.png",
      "TimeZone": "Europe/Moscow",
      "Lines": [
        {
          "Text": "Доп. соглашение {Date}",
          "X": 20,
          "Y": 50,
          "FontSize": 22
        }
      ],
      "Page": -1,
      "X": 30,
      "Y": 30,
      "WidthPt": 160,
      "HeightPt": 60
    }
  },
  "Smb": {
    "Domain": "CORP",
    "User": "svc-docrouter",
    "Password": "set-via-secret"
  },
  "SignatureService": {
    "SignUrl": "https://sign.example.com/api/sign",
    "VerifyUrl": "https://sign.example.com/api/verify",
    "Timeout": "00:01:00"
  },
  "Oracle": {
    "ConnectionString": "User Id=docrouter;Password=set-via-secret;Data Source=//oracle-host:1521/SERVICE",
    "SaveSignatureProcedure": "PKG_DOCS.SAVE_SIGNATURE"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 25,
    "UseSsl": false,
    "From": "docrouter@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}