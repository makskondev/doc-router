{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=docrouter;Username=docrouter;Password=change-me"
  },
  "Database": {
    "AutoMigrate": true
  },
  "Engine": {
    "PollInterval": "00:10:00",
    "TickInterval": "00:00:30",
    "BatchSize": 20,
    "MaxParallel": 4,
    "LeaseDuration": "00:15:00",
    "MaxTransientAttempts": 5,
    "BackoffMinutes": [
      1,
      5,
      15,
      60,
      240
    ],
    "DefaultRecipients": [
      "docs-support@example.com"
    ]
  },
  "Sources": {
    "Views": [
      {
        "Name": "VIEW_1",
        "IdColumn": "DOC_ID",
        "FileNameColumn": "FILE_NAME",
        "DocTypeColumn": "DOC_TYPE"
      },
      {
        "Name": "VIEW_2",
        "IdColumn": "DOC_ID",
        "FileNameColumn": "FILE_NAME",
        "FixedDocType": "Act"
      }
    ],
    "Directories": [
      {
        "DocType": "Letter",
        "RequireSignature": false,
        "MinAge": "00:01:00",
        "Extensions": [
          ".pdf"
        ]
      },
      {
        "DocType": "SignedLetter",
        "RequireSignature": true,
        "SignatureSuffix": ".sig",
        "MinAge": "00:01:00"
      }
    ]
  },
  "DocumentTypes": {
    "Invoice": {
      "Incoming": "\\\\fileserver\\docs\\invoice\\in",
      "Result": "\\\\fileserver\\archive\\invoice",
      "ErrorRecipients": [
        "invoice-team@example.com"
      ]
    },
    "Act": {
      "Incoming": "\\\\fileserver\\docs\\act\\in",
      "Result": "\\\\fileserver\\archive\\act",
      "ErrorRecipients": [
        "act-team@example.com"
      ]
    },
    "Agreement": {
      "Incoming": "\\\\fileserver\\docs\\agreement\\in",
      "ToSign": "\\\\fileserver\\docs\\agreement\\tosign",
      "Signed": "\\\\fileserver\\docs\\agreement\\signed",
      "Result": "\\\\fileserver\\archive\\agreement",
      "ErrorRecipients": [
        "agreement-team@example.com"
      ]
    },
    "Letter": {
      "Incoming": "\\\\fileserver\\docs\\letter\\in",
      "Result": "\\\\fileserver\\archive\\letter",
      "ErrorRecipients": [
        "letter-team@example.com"
      ]
    },
    "SignedLetter": {
      "Incoming": "\\\\fileserver\\docs\\signedletter\\in",
      "Result": "\\\\fileserver\\archive\\signedletter",
      "ErrorRecipients": [
        "letter-team@example.com"
      ]
    }
  },
  "Smb": {
    "Domain": "CORP",
    "User": "svc-docrouter",
    "Password": "set-via-secret"
  },
  "SignatureService": {
    "SignUrl": "https://sign.example.com/api/sign",
    "VerifyUrl": "https://sign.example.com/api/verify",
    "Timeout": "00:01:00"
  },
  "Oracle": {
    "ConnectionString": "User Id=docrouter;Password=set-via-secret;Data Source=//oracle-host:1521/SERVICE",
    "SaveSignatureProcedure": "PKG_DOCS.SAVE_SIGNATURE"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 25,
    "UseSsl": false,
    "From": "docrouter@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Stamps": {
    "agreement": {
      "TemplatePath": "/app/stamps/agreement.png",
      "FontFamily": "DejaVu Sans",
      "Color": "#1F3A93",
      "TimeZone": "Europe/Moscow",
      "Lines": [
        {
          "Text": "Согласовано {Date}",
          "X": 20,
          "Y": 50,
          "FontSize": 24
        },
        {
          "Text": "{AUTHOR}",
          "X": 20,
          "Y": 90,
          "FontSize": 20
        }
      ],
      "Page": -1,
      "X": 30,
      "Y": 30,
      "WidthPt": 160,
      "HeightPt": 60
    }
  }
}