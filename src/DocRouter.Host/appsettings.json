{
  "Courier": { "PollInterval": "00:10:00", "MaxParallel": 4, "ReadinessMultiplier": 3 },

  "Dirs": {
    "Docs": "\\\\fileserver\\docs",
    "Signed": "\\\\fileserver\\signed",
    "Reports": "\\\\fileserver\\reports",
    "DepoReportsIn": "\\\\fileserver\\reports-in\\depo",
    "BrokReportsIn": "\\\\fileserver\\reports-in\\brok",
    "StampTemplates": "/app/stamps"
  },

  "Mail": {
    "Default": "docs-support@example.com",
    "Brokers": "broker-team@example.com",
    "Depo": "depo-team@example.com"
  },

  "Smb": { "Domain": "CORP", "User": "svc-docrouter", "Password": "set-via-secret" },
  "SignatureService": { "SignUrl": "https://sign.example.com/api/sign", "VerifyUrl": "https://sign.example.com/api/verify", "Timeout": "00:01:00" },
  "Oracle": { "ConnectionString": "User Id=docrouter;Password=set-via-secret;Data Source=//oracle-host:1521/SERVICE", "SaveSignatureProcedure": "PKG_DOCS.SAVE_SIGNATURE" },
  "Smtp": { "Host": "smtp.example.com", "Port": 25, "UseSsl": false, "From": "docrouter@example.com" },

  "Logging": { "LogLevel": { "Default": "Information" } },
  "AllowedHosts": "*"
}
