{
  "Courier": {
    "PollInterval": "00:10:00",
    "MaxParallel": 4,
    "ReadinessMultiplier": 3
  },
  "Dirs": {
    "BrokRep": "\\\\fd\\brok_rep",
    "BrokRepEmail": "\\\\fd\\brok_rep\\email",
    "SignedDocs": "\\\\fd\\signed_docs",
    "DepoReports": "\\\\fd\\depo_reports",
    "WasSignedDepo": "\\\\fd\\sign_proc\\was_signed\\depo",
    "WasSignedBrok": "\\\\fd\\sign_proc\\was_signed\\brok",
    "BrokDocs": "\\\\fd\\brok\\docs",
    "BrokToSign": "\\\\fd\\sign_proc\\to_sign\\brok",
    "CorpSignedDoc": "\\\\fd\\corp\\signed_doc"
  },
  "Mail": {
    "Default": "docs-support@example.com",
    "Brokers": "broker-team@example.com",
    "Depo": "depo-team@example.com"
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Database=docrouter;Username=docrouter;Password=set-via-secret"
  },
  "Smb": {
    "Domain": "CORP",
    "User": "svc-docrouter",
    "Password": "set-via-secret"
  },
  "SignatureService": {
    "SignUrl": "https://sign.example.com/api/sign",
    "VerifyUrl": "https://sign.example.com/api/verify",
    "Timeout": "00:01:00"
  },
  "Oracle": {
    "ConnectionString": "User Id=docrouter;Password=set-via-secret;Data Source=//oracle-host:1521/SERVICE",
    "MarkSignedProcedure": "PKG_DOCS.MARK_REPORT_SIGNED",
    "CreateRecordProcedure": "PKG_DOCS.CREATE_SIGNED_FILE"
  },
  "Smtp": {
    "Host": "smtp.example.com",
    "Port": 25,
    "UseSsl": false,
    "From": "docrouter@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}