{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=docrouter;Username=docrouter;Password=change-me"
  },
  "Database": { "AutoMigrate": true },

  "Engine": {
    "PollInterval": "00:10:00",
    "TickInterval": "00:00:30",
    "BatchSize": 20,
    "MaxParallel": 4,
    "LeaseDuration": "00:15:00",
    "MaxTransientAttempts": 5,
    "BackoffMinutes": [1, 5, 15, 60, 240],
    "DefaultRecipients": [ "docs-support@example.com" ]
  },

  "Sources": {
    "Views": [
      { "Name": "VIEW_1", "IdColumn": "DOC_ID", "FileNameColumn": "FILE_NAME", "DocTypeColumn": "DOC_TYPE" },
      { "Name": "VIEW_2", "IdColumn": "DOC_ID", "FileNameColumn": "FILE_NAME", "FixedDocType": "Act" }
    ]
  },

  "DocumentTypes": {
    "Invoice": {
      "Incoming": "\\\\fileserver\\docs\\invoice\\in",
      "Result": "\\\\fileserver\\archive\\invoice",
      "ErrorRecipients": [ "invoice-team@example.com" ]
    },
    "Act": {
      "Incoming": "\\\\fileserver\\docs\\act\\in",
      "Result": "\\\\fileserver\\archive\\act",
      "ErrorRecipients": [ "act-team@example.com" ]
    }
  },

  "Smb": { "Domain": "CORP", "User": "svc-docrouter", "Password": "set-via-secret" },
  "SignatureService": { "SignUrl": "https://sign.example.com/api/sign", "VerifyUrl": "https://sign.example.com/api/verify", "Timeout": "00:01:00" },
  "Oracle": {
    "ConnectionString": "User Id=docrouter;Password=set-via-secret;Data Source=//oracle-host:1521/SERVICE",
    "SaveSignatureProcedure": "PKG_DOCS.SAVE_SIGNATURE"
  },
  "Smtp": { "Host": "smtp.example.com", "Port": 25, "UseSsl": false, "From": "docrouter@example.com" },

  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*"
}
